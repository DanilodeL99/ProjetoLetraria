@using Microsoft.AspNetCore.Http
@{
    var nomeUsuario = Context.Session.GetString("UsuarioNome");
    var tipoUsuario = Context.Session.GetString("TipoUsuario");
    var fotoPerfil = Context.Session.GetString("FotoPerfil");
    var fotoMostrada = string.IsNullOrWhiteSpace(fotoPerfil) ? "/imagens/usuario-padrao.png" : fotoPerfil;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Letraria</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-letraria">

    <nav class="navbar navbar-expand-lg navbar-dark navbar-letraria px-3 px-lg-4">
        <a class="navbar-brand fw-bold fs-3 text-white" asp-controller="Home" asp-action="Index">Letraria</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuTop">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menuTop">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-2">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Biblioteca</a>
                </li>

                @if (tipoUsuario == "ADMIN")
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Admin" asp-action="Livros">Painel Admin</a>
                    </li>
                }

                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Perfil" asp-action="Editar">Minha conta</a>
                </li>
            </ul>

            @if (!string.IsNullOrWhiteSpace(nomeUsuario))
            {
                <div class="d-flex align-items-center gap-2 text-white">
                    <img src="@fotoMostrada" class="rounded-circle border border-2 border-white" style="width:38px;height:38px;object-fit:cover;" />
                    <span class="fw-semibold">@nomeUsuario</span>
                    <a class="text-white ms-2" asp-controller="Login" asp-action="Logout">Sair</a>
                </div>
            }
        </div>
    </nav>

    <main class="container-fluid py-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>