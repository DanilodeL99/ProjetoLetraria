@model List<ProjetoLetraria.Models.Livro>
@{
    ViewData["Title"] = "Início";
}

<div class="row g-4">
    <aside class="col-12 col-lg-3">
        <div class="card card-letraria p-3">
            <h4 class="fw-bold mb-3 text-letraria">Categorias</h4>
            <div class="sidebar-categorias">
                <a href="#">Literatura Brasileira</a>
                <a href="#">Romance</a>
                <a href="#">Fantasia</a>
                <a href="#">Terror</a>
                <a href="#">Drama</a>
                <a href="#">Filosofia</a>
                <a href="#">Biografia</a>
            </div>
        </div>
    </aside>

    <section class="col-12 col-lg-9">
        <div class="card card-letraria p-4 mb-4">
            <h1 class="fw-bold mb-1">Biblioteca Digital</h1>
            <p class="text-muted mb-0">Indicações, leitura e avaliações em um só lugar.</p>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var livro in Model)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card card-letraria h-100 overflow-hidden">
                            <img class="cover-book"
                                 src="@(string.IsNullOrWhiteSpace(livro.ImagemCapa) ? "/imagens/capa-padrao.jpg" : livro.ImagemCapa)"
                                 alt="Capa de @livro.Titulo" />

                            <div class="card-body d-flex flex-column">
                                <h5 class="fw-bold mb-1">@livro.Titulo</h5>
                                <p class="text-muted mb-2">@livro.Autor</p>

                                <span class="badge badge-letraria mb-3 align-self-start">@livro.Genero</span>

                                <p class="fw-semibold mb-3">
                                    @(livro.Preco.HasValue ? $"R$ {livro.Preco:0.00}" : "Gratuito")
                                </p>

                                <div class="mt-auto d-flex gap-2">
                                    <a href="#" class="btn btn-letraria flex-grow-1">Ler</a>
                                    <a href="#" class="btn btn-outline-dark flex-grow-1">Comprar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning card-letraria border-0">
                        Nenhum livro cadastrado ainda.
                    </div>
                </div>
            }
        </div>
    </section>
</div>