@* Views/Home/Index.cshtml *@
@model ProjetoLetraria.ViewModels.HomeViewModel

<div class="page-home">
    <section class="feed-center">
        <div class="card-composer">
            <div class="composer-header">
                <h2>Início</h2>
                <p>Publique sua opinião sobre livros, obras e leituras.</p>
            </div>

            <form asp-action="PublicarAvaliacao" method="post" class="composer-form">
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <label>Livro / obra</label>
                    <select asp-for="LivroSelecionadoId" class="form-control">
                        <option value="">Selecione um livro</option>
                        @foreach (var livro in Model.LivrosRecentes)
                        {
                            <option value="@livro.IdLivro">@livro.Titulo</option>
                        }
                    </select>
                    <span asp-validation-for="LivroSelecionadoId" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <label>Nota</label>
                    <select asp-for="NotaNova" class="form-control">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>
                    <span asp-validation-for="NotaNova" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <label>Sua opinião</label>
                    <textarea asp-for="ComentarioNovo" rows="4" class="form-control" placeholder="O que você achou da obra?"></textarea>
                    <span asp-validation-for="ComentarioNovo" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-twitter">Publicar</button>
            </form>
        </div>

        <div class="feed-list">
            @foreach (var post in Model.AvaliacoesRecentes)
            {
                var idLogado = Context.Session.GetInt32("IdUsuario");
                var tipoLogado = Context.Session.GetString("TipoUsuario");
                var podeExcluir = tipoLogado == "ADMIN" || tipoLogado == "PROFESSOR" || (idLogado.HasValue && idLogado.Value == post.Usuario?.IdUsuario);

                <article class="post-card">
                    <div class="post-head">
                        <a asp-controller="Usuario"
                           asp-action="Perfil"
                           asp-route-id="@post.Usuario!.IdUsuario"
                           class="profile-link">
                            <img src="@(string.IsNullOrWhiteSpace(post.Usuario?.FotoPerfil) ? "/imagens/usuario-padrao.png" : post.Usuario!.FotoPerfil)"
                                 class="avatar-post" />
                        </a>

                        <div>
                            <a asp-controller="Usuario"
                               asp-action="Perfil"
                               asp-route-id="@post.Usuario!.IdUsuario"
                               class="profile-link-name">
                                <strong>@(post.Usuario?.NomeExibicao ?? post.Usuario?.Nome)</strong>
                                <span class="role-badge @(post.Usuario?.TipoUsuario?.ToLower() ?? "aluno")">@post.Usuario?.TipoUsuario</span>
                            </a>

                            <div class="muted">
                                @post.DataAvaliacao.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        @if (podeExcluir)
                        {
                            <details class="post-menu">
                                <summary class="post-menu-btn">⋯</summary>
                                <div class="post-menu-box">
                                    <form asp-controller="Feed" asp-action="ExcluirAvaliacao" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@post.IdAvaliacao" />
                                        <button type="submit" class="post-menu-action danger">Excluir opinião</button>
                                    </form>
                                </div>
                            </details>
                        }
                    </div>

                    <h3 class="post-book">@post.Livro?.Titulo</h3>
                    <div class="post-rating">Nota: @post.Nota / 5</div>
                    <p class="post-text">@post.Comentario</p>

                    <div class="acoes-post">
                        <form asp-controller="Feed" asp-action="Curtir" method="post" class="like-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@post.IdAvaliacao" />
                            <button type="submit" class="btn-like">
                                <span class="like-icon">❤️</span>
                                <span class="like-count">@post.Curtidas.Count</span>
                            </button>
                        </form>

                        <span class="muted">💬 @post.Comentarios.Count</span>
                    </div>

                    <div class="comentarios-feed">
                        @foreach (var comentario in post.Comentarios.OrderByDescending(c => c.DataComentario))
                        {
                            <div class="comentario-feed">
                                <img src="@(string.IsNullOrWhiteSpace(comentario.Usuario?.FotoPerfil) ? "/imagens/usuario-padrao.png" : comentario.Usuario!.FotoPerfil)"
                                     class="comentario-avatar" />

                                <div class="comentario-body">
                                    <a asp-controller="Usuario"
                                       asp-action="Perfil"
                                       asp-route-id="@comentario.Usuario!.IdUsuario"
                                       class="profile-link-name">
                                        <strong>@(comentario.Usuario?.NomeExibicao ?? comentario.Usuario?.Nome)</strong>
                                        <span class="role-badge @(comentario.Usuario?.TipoUsuario?.ToLower() ?? "aluno")">@comentario.Usuario?.TipoUsuario</span>
                                    </a>
                                    <p>@comentario.Texto</p>
                                </div>
                            </div>
                        }
                    </div>

                    <form asp-controller="Feed" asp-action="Comentar" method="post" class="form-comentario">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="avaliacaoId" value="@post.IdAvaliacao" />
                        <input type="text" name="texto" placeholder="Responder..." class="form-control" />
                        <button type="submit" class="btn-twitter">Enviar</button>
                    </form>
                </article>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}