@model ProjetoLetraria.ViewModels.EditarPerfilViewModel
@{
    ViewData["Title"] = "Minha conta";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card card-letraria p-4">
            <h1 class="fw-bold mb-4">Editar conta</h1>

            <form asp-action="Editar" method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nome</label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Nome de exibição</label>
                        <input asp-for="NomeExibicao" class="form-control" />
                        <span asp-validation-for="NomeExibicao" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Foto de perfil</label>
                        @if (!string.IsNullOrWhiteSpace(Model.FotoAtual))
                        {
                            <div class="mb-2">
                                <img src="@Model.FotoAtual" style="width:96px;height:96px;object-fit:cover;" class="rounded-circle border" />
                            </div>
                        }
                        <input asp-for="FotoArquivo" type="file" class="form-control" />
                    </div>

                    <hr class="my-3" />

                    <div class="col-12">
                        <h5 class="fw-semibold">Alterar senha</h5>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Senha atual</label>
                        <input asp-for="SenhaAtual" type="password" class="form-control" />
                        <span asp-validation-for="SenhaAtual" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Nova senha</label>
                        <input asp-for="NovaSenha" type="password" class="form-control" />
                        <span asp-validation-for="NovaSenha" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Confirmar nova senha</label>
                        <input asp-for="ConfirmarNovaSenha" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmarNovaSenha" class="text-danger"></span>
                    </div>

                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-letraria px-4">Salvar alterações</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}