@model List<ProjetoLetraria.Models.Livro>
@{
    ViewData["Title"] = "Painel Admin";
}

<div class="card card-letraria p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="fw-bold mb-1">Gerenciar livros</h1>
            <p class="text-muted mb-0">Apenas administradores podem adicionar, editar e excluir livros.</p>
        </div>

        <a asp-action="AdicionarLivro" class="btn btn-letraria px-4">Adicionar livro</a>
    </div>
</div>

<div class="card card-letraria p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Preço</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var livro in Model)
                {
                    <tr>
                        <td>@livro.IdLivro</td>
                        <td>@livro.Titulo</td>
                        <td>@livro.Autor</td>
                        <td>@(livro.Preco.HasValue ? $"R$ {livro.Preco:0.00}" : "Gratuito")</td>
                        <td class="d-flex gap-2">
                            <a asp-action="EditarLivro" asp-route-id="@livro.IdLivro" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="ExcluirLivro" asp-route-id="@livro.IdLivro" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>