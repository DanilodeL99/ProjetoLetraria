@* Views/Admin/Livros.cshtml *@
@model List<ProjetoLetraria.Models.Livro>
@{
    ViewData["Title"] = "Painel Admin";
}

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1>Painel Admin</h1>
            <p>Gerencie livros da plataforma.</p>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a asp-action="Dashboard" class="btn-secondary">Dashboard</a>
            <a asp-action="AdicionarLivro" class="btn-twitter">Adicionar livro</a>
        </div>
    </div>

    <div class="admin-table-card">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Preço</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var livro in Model)
                {
                    <tr>
                        <td>@livro.Titulo</td>
                        <td>@livro.Autor</td>
                        <td>@(livro.Preco.HasValue ? $"R$ {livro.Preco:0.00}" : "Gratuito")</td>
                        <td class="admin-actions">
                            <a asp-action="EditarLivro" asp-route-id="@livro.IdLivro">Editar</a>
                            <a asp-action="ExcluirLivro" asp-route-id="@livro.IdLivro" class="danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>