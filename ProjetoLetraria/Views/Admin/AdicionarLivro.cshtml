@* Views/Admin/AdicionarLivro.cshtml *@
@model ProjetoLetraria.ViewModels.LivroFormViewModel
@{
    ViewData["Title"] = "Adicionar livro";
}

<div class="admin-form-page">
    <div class="admin-form-card">
        <h1>Adicionar livro</h1>

        <form asp-action="AdicionarLivro" method="post" class="admin-form-grid">
            <div class="form-row">
                <label>Título</label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label>Autor</label>
                <input asp-for="Autor" class="form-control" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>

            <div class="form-row full">
                <label>Resumo</label>
                <textarea asp-for="Resumo" class="form-control"></textarea>
                <span asp-validation-for="Resumo" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label>Gênero</label>
                <input asp-for="Genero" class="form-control" />
            </div>

            <div class="form-row">
                <label>Imagem da capa</label>
                <input asp-for="ImagemCapa" class="form-control" />
            </div>

            <div class="form-row">
                <label>Tipo de acesso</label>
                <select asp-for="TipoAcesso" class="form-control">
                    <option value="DIGITAL">Digital</option>
                    <option value="COMPRA">Compra</option>
                </select>
            </div>

            <div class="form-row">
                <label>Link de compra</label>
                <input asp-for="LinkCompra" class="form-control" />
            </div>

            <div class="form-row">
                <label>Arquivo do livro</label>
                <input asp-for="ArquivoLivro" class="form-control" />
            </div>

            <div class="form-row">
                <label>Preço</label>
                <input asp-for="Preco" class="form-control" />
            </div>

            <div class="form-row">
                <label>
                    <input asp-for="LivroGratis" id="livroGratis" type="checkbox" />
                    Livro gratuito
                </label>
            </div>

            <div class="form-row">
                <label>Tags</label>
                <div class="tags-box">
                    @foreach (var tag in Model.TagsDisponiveis)
                    {
                        <label class="tag-check">
                            <input type="checkbox" name="TagsSelecionadas" value="@tag.IdTag" />
                            <span>@tag.Nome</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-row full">
                <button type="submit" class="btn-twitter">Salvar</button>
            </div>
        </form>
    </div>
</div>