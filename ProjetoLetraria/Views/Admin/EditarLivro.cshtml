@* Views/Admin/EditarLivro.cshtml *@
@model ProjetoLetraria.ViewModels.LivroFormViewModel
@{
    ViewData["Title"] = "Editar livro";
}

<div class="admin-form-page">
    <div class="admin-form-card">
        <h1>Editar livro</h1>

        <form asp-action="EditarLivro" method="post" enctype="multipart/form-data" class="admin-form-grid">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdLivro" />
            <input type="hidden" asp-for="ImagemCapa" />
            <input type="hidden" asp-for="ArquivoLivro" />

            <div class="form-row">
                <label>Título</label>
                <input asp-for="Titulo" class="form-control" />
            </div>

            <div class="form-row">
                <label>Autor</label>
                <input asp-for="Autor" class="form-control" />
            </div>

            <div class="form-row full">
                <label>Resumo</label>
                <textarea asp-for="Resumo" class="form-control"></textarea>
            </div>

            <div class="form-row">
                <label>Gênero</label>
                <input asp-for="Genero" class="form-control" />
            </div>

            <div class="form-row">
                <label>Trocar imagem da capa</label>
                <input asp-for="ImagemCapaArquivo" type="file" accept="image/*" class="form-control" />
            </div>

            <div class="form-row">
                <label>Trocar arquivo do livro</label>
                <input asp-for="ArquivoLivroArquivo" type="file" accept=".pdf,.txt,.epub,.doc,.docx,application/pdf,text/plain" class="form-control" />
            </div>

            <div class="form-row">
                <label>Preço</label>
                <input asp-for="Preco" class="form-control" />
            </div>

            <div class="form-row">
                <label>
                    <input asp-for="LivroGratis" type="checkbox" />
                    Livro gratuito
                </label>
            </div>

            <div class="form-row">
                <label>
                    <input asp-for="PossuiDigital" type="checkbox" />
                    Versão digital
                </label>
            </div>

            <div class="form-row">
                <label>
                    <input asp-for="PossuiFisico" type="checkbox" />
                    Versão física
                </label>
            </div>

            <div class="form-row">
                <label>Tags</label>
                <div class="tags-box">
                    @foreach (var tag in Model.TagsDisponiveis)
                    {
                        var marcado = Model.TagsSelecionadas.Contains(tag.IdTag);
                        <label class="tag-check">
                            <input type="checkbox" name="TagsSelecionadas" value="@tag.IdTag" checked="@(marcado ? "checked" : null)" />
                            <span>@tag.Nome</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-row full">
                <button type="submit" class="btn-twitter">Atualizar</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.ImagemCapa))
        {
            <div style="margin-top:18px;">
                <p class="muted">Imagem atual:</p>
                <img src="@Model.ImagemCapa" alt="Capa atual" style="width:140px;height:200px;object-fit:cover;border-radius:14px;" />
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}