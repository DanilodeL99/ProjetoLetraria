@* Views/Admin/Dashboard.cshtml *@
@model ProjetoLetraria.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">
    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>Resumo de usuários, vendas e desempenho da loja.</p>
        </div>

        <a asp-controller="Login" asp-action="Cadastro" class="btn-twitter">Cadastrar usuário</a>
    </div>

    <div class="dashboard-stats">
        <div class="stat-card">
            <div class="label">Usuários</div>
            <div class="value">@Model.TotalUsuarios</div>
        </div>

        <div class="stat-card">
            <div class="label">Livros</div>
            <div class="value">@Model.TotalLivros</div>
        </div>

        <div class="stat-card">
            <div class="label">Compras</div>
            <div class="value">@Model.TotalCompras</div>
        </div>

        <div class="stat-card">
            <div class="label">Valor arrecadado</div>
            <div class="value">R$ @Model.ValorArrecadado.ToString("0.00")</div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>Registro de compras</h3>

            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Livro</th>
                        <th>Valor</th>
                        <th>Pagamento</th>
                        <th>Data</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var compra in Model.ComprasRecentes)
                    {
                        <tr>
                            <td>@compra.Cliente</td>
                            <td>@compra.Livro</td>
                            <td>R$ @compra.Valor.ToString("0.00")</td>
                            <td>@compra.MetodoPagamento</td>
                            <td>@compra.DataCompra.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dashboard-card">
            <h3>Top livros</h3>

            <div class="dashboard-list">
                @foreach (var item in Model.LivrosMaisVendidos)
                {
                    <div class="dashboard-list-item">
                        <div>
                            <strong>@item.Titulo</strong>
                            <div class="muted">@item.Autor</div>
                        </div>
                        <div>
                            <strong>@item.QuantidadeVendida</strong>
                        </div>
                    </div>
                }
            </div>

            <hr />

            <h3>Categoria mais vendida</h3>
            <p><strong>@(Model.CategoriaMaisVendida ?? "Sem vendas")</strong></p>
        </div>
    </div>
</div>