@* Views/Usuario/Perfil.cshtml *@
@model ProjetoLetraria.ViewModels.PerfilUsuarioViewModel

<div class="profile-page">
    <section class="profile-card card-panel">
        <div class="profile-cover"></div>

        <div class="profile-head">
            <img src="@(string.IsNullOrWhiteSpace(Model.UsuarioVisualizado.FotoPerfil) ? "/imagens/usuario-padrao.png" : Model.UsuarioVisualizado.FotoPerfil)"
                 class="profile-avatar" />

            <div class="profile-main">
                <h1>
                    @(Model.UsuarioVisualizado.NomeExibicao ?? Model.UsuarioVisualizado.Nome)
                    <span class="role-badge @(Model.UsuarioVisualizado.TipoUsuario.ToLower())">
                        @Model.UsuarioVisualizado.TipoUsuario
                    </span>
                </h1>

                <p class="muted">@Model.UsuarioVisualizado.TipoUsuario</p>

                <div class="profile-stats">
                    <span><strong>@Model.Seguidores</strong> Seguidores</span>
                    <span><strong>@Model.Seguindo</strong> Seguindo</span>
                    <span><strong>@Model.Avaliacoes.Count</strong> Avaliações</span>
                </div>
            </div>

            <div class="profile-actions">
                @if (Model.EhMeuPerfil)
                {
                    <a asp-controller="Perfil" asp-action="Editar" class="btn-secondary">Editar perfil</a>
                }
                else
                {
                    <form asp-controller="Usuario" asp-action="AlternarSeguir" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.UsuarioVisualizado.IdUsuario" />
                        <button type="submit" class="btn-twitter follow-btn">
                            @(Model.EstouSeguindo ? "Seguindo" : "Seguir")
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="profile-tabs">
            <a href="#avaliacoes">Avaliações (@Model.Avaliacoes.Count)</a>
            <a href="#curtidas">Curtidas (@Model.Curtidas.Count)</a>
            <a href="#comentarios">Comentários (@Model.Comentarios.Count)</a>
        </div>
    </section>

    <section class="profile-section" id="avaliacoes">
        <div class="section-title">
            <h2>Avaliações</h2>
        </div>

        <div class="feed-list">
            @foreach (var post in Model.Avaliacoes)
            {
                var idLogado = Context.Session.GetInt32("IdUsuario");
                var tipoLogado = Context.Session.GetString("TipoUsuario");
                var podeExcluir = tipoLogado == "ADMIN" || tipoLogado == "PROFESSOR" || (idLogado.HasValue && idLogado.Value == post.Usuario?.IdUsuario);

                <article class="post-card">
                    <div class="post-head">
                        <a asp-controller="Usuario"
                           asp-action="Perfil"
                           asp-route-id="@Model.UsuarioVisualizado.IdUsuario"
                           class="profile-link">
                            <img src="@(string.IsNullOrWhiteSpace(Model.UsuarioVisualizado.FotoPerfil) ? "/imagens/usuario-padrao.png" : Model.UsuarioVisualizado.FotoPerfil)"
                                 class="avatar-post" />
                        </a>

                        <div>
                            <a asp-controller="Usuario"
                               asp-action="Perfil"
                               asp-route-id="@Model.UsuarioVisualizado.IdUsuario"
                               class="profile-link-name">
                                <strong>@(Model.UsuarioVisualizado.NomeExibicao ?? Model.UsuarioVisualizado.Nome)</strong>
                                <span class="role-badge @(Model.UsuarioVisualizado.TipoUsuario.ToLower())">@Model.UsuarioVisualizado.TipoUsuario</span>
                            </a>

                            <div class="muted">@post.DataAvaliacao.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>

                        @if (podeExcluir)
                        {
                            <details class="post-menu">
                                <summary class="post-menu-btn">⋯</summary>
                                <div class="post-menu-box">
                                    <form asp-controller="Feed" asp-action="ExcluirAvaliacao" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@post.IdAvaliacao" />
                                        <button type="submit" class="post-menu-action danger">Excluir opinião</button>
                                    </form>
                                </div>
                            </details>
                        }
                    </div>

                    <h3 class="post-book">@post.Livro?.Titulo</h3>
                    <div class="post-rating">Nota: @post.Nota / 5</div>
                    <p class="post-text">@post.Comentario</p>

                    <div class="acoes-post">
                        <form asp-controller="Feed" asp-action="Curtir" method="post" class="like-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@post.IdAvaliacao" />
                            <button type="submit" class="btn-like">
                                <span class="like-icon">❤️</span>
                                <span class="like-count">@post.Curtidas.Count</span>
                            </button>
                        </form>

                        <span class="muted">💬 @post.Comentarios.Count</span>
                    </div>

                    <div class="comentarios-feed">
                        @foreach (var comentario in post.Comentarios.OrderByDescending(c => c.DataComentario))
                        {
                            <div class="comentario-feed">
                                <img src="@(string.IsNullOrWhiteSpace(comentario.Usuario?.FotoPerfil) ? "/imagens/usuario-padrao.png" : comentario.Usuario!.FotoPerfil)"
                                     class="comentario-avatar" />

                                <div class="comentario-body">
                                    <a asp-controller="Usuario"
                                       asp-action="Perfil"
                                       asp-route-id="@comentario.Usuario!.IdUsuario"
                                       class="profile-link-name">
                                        <strong>@(comentario.Usuario?.NomeExibicao ?? comentario.Usuario?.Nome)</strong>
                                        <span class="role-badge @(comentario.Usuario?.TipoUsuario?.ToLower() ?? "aluno")">@comentario.Usuario?.TipoUsuario</span>
                                    </a>
                                    <p>@comentario.Texto</p>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="profile-section" id="curtidas">
        <div class="section-title">
            <h2>Curtidas</h2>
        </div>

        <div class="feed-list">
            @foreach (var post in Model.Curtidas)
            {
                <article class="post-card">
                    <div class="post-head">
                        <a asp-controller="Usuario"
                           asp-action="Perfil"
                           asp-route-id="@post.Usuario!.IdUsuario"
                           class="profile-link">
                            <img src="@(string.IsNullOrWhiteSpace(post.Usuario?.FotoPerfil) ? "/imagens/usuario-padrao.png" : post.Usuario!.FotoPerfil)"
                                 class="avatar-post" />
                        </a>

                        <div>
                            <a asp-controller="Usuario"
                               asp-action="Perfil"
                               asp-route-id="@post.Usuario!.IdUsuario"
                               class="profile-link-name">
                                <strong>@(post.Usuario?.NomeExibicao ?? post.Usuario?.Nome)</strong>
                                <span class="role-badge @(post.Usuario?.TipoUsuario?.ToLower() ?? "aluno")">@post.Usuario?.TipoUsuario</span>
                            </a>

                            <div class="muted">@post.DataAvaliacao.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>

                    <h3 class="post-book">@post.Livro?.Titulo</h3>
                    <div class="post-rating">Nota: @post.Nota / 5</div>
                    <p class="post-text">@post.Comentario</p>

                    <div class="acoes-post">
                        <form asp-controller="Feed" asp-action="Curtir" method="post" class="like-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@post.IdAvaliacao" />
                            <button type="submit" class="btn-like">
                                <span class="like-icon">❤️</span>
                                <span class="like-count">@post.Curtidas.Count</span>
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="profile-section" id="comentarios">
        <div class="section-title">
            <h2>Comentários</h2>
        </div>

        <div class="feed-list">
            @foreach (var comentario in Model.Comentarios)
            {
                <article class="post-card">
                    <div class="post-head">
                        <img src="@(string.IsNullOrWhiteSpace(comentario.Usuario?.FotoPerfil) ? "/imagens/usuario-padrao.png" : comentario.Usuario!.FotoPerfil)"
                             class="avatar-post" />

                        <div>
                            <a asp-controller="Usuario"
                               asp-action="Perfil"
                               asp-route-id="@comentario.Usuario!.IdUsuario"
                               class="profile-link-name">
                                <strong>@(comentario.Usuario?.NomeExibicao ?? comentario.Usuario?.Nome)</strong>
                                <span class="role-badge @(comentario.Usuario?.TipoUsuario?.ToLower() ?? "aluno")">@comentario.Usuario?.TipoUsuario</span>
                            </a>

                            <div class="muted">@comentario.DataComentario.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>

                    <h3 class="post-book">@comentario.Avaliacao?.Livro?.Titulo</h3>
                    <p class="post-text">@comentario.Texto</p>
                </article>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}