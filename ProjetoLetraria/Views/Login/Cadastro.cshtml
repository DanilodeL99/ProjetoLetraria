@* Views/Login/Cadastro.cshtml *@
@model ProjetoLetraria.ViewModels.CadastroViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Letraria - Cadastro</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-bg">

    <div class="login-wrap">
        <div class="login-hero cadastro-hero">
            <div class="login-hero-overlay">
                <img src="~/imagens/logo-letraria.jpeg" alt="Letraria" class="login-brand-image" />
                <h1>Letraria</h1>
                <p>Crie sua conta para começar a ler, avaliar e comprar.</p>
            </div>
        </div>

        <div class="login-form-box">
            <h2>Criar conta</h2>
            <p>Professor ou aluno.</p>

            <form asp-controller="Login" asp-action="Cadastro" method="post">
                <div class="form-row">
                    <label>Nome</label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <label>E-mail</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <label>Senha</label>
                    <input asp-for="Senha" type="password" class="form-control" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <label>Confirmar senha</label>
                    <input asp-for="ConfirmarSenha" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <label>Tipo de usuário</label>
                    <select asp-for="TipoUsuario" class="form-control" id="tipoUsuario">
                        <option value="">Selecione</option>
                        <option value="ALUNO">Aluno</option>
                        <option value="PROFESSOR">Professor</option>
                    </select>
                    <span asp-validation-for="TipoUsuario" class="text-danger"></span>
                </div>

                <div class="form-row" id="campoCndb" style="display:none;">
                    <label>CNDB</label>
                    <input asp-for="Cndb" class="form-control" />
                    <span asp-validation-for="Cndb" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-twitter full-width">Criar conta</button>
            </form>

            <div class="center-link">
                <a asp-controller="Login" asp-action="Index">Já tenho conta</a>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        const tipoUsuario = document.getElementById('tipoUsuario');
        const campoCndb = document.getElementById('campoCndb');

        function atualizarCndb() {
            const mostrar = tipoUsuario.value === 'PROFESSOR';
            campoCndb.style.display = mostrar ? 'block' : 'none';
        }

        tipoUsuario.addEventListener('change', atualizarCndb);
        atualizarCndb();
    </script>
</body>
</html>