@* Views/Login/Index.cshtml *@
@model ProjetoLetraria.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Letraria - Login</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-bg">

    <div class="login-wrap">
        <div class="login-hero">
            <div class="login-hero-overlay">
                <img src="~/imagens/logo-letraria.jpeg" alt="Letraria" class="login-brand-image" />
                <h1>Letraria</h1>
                <p>Sua biblioteca digital educacional</p>
            </div>
        </div>

        <div class="login-form-box">
            <h2>Entrar</h2>
            <p>Acesse sua conta para continuar.</p>

            @if (ViewBag.Erro != null)
            {
                <div class="card-panel" style="margin-bottom:18px;border-color:#7a2630;background:#2a1418;">
                    @ViewBag.Erro
                </div>
            }

            <form asp-controller="Login" asp-action="Logar" method="post">
                <div class="form-row">
                    <label>E-mail</label>
                    <input asp-for="Email" class="form-control" placeholder="Digite seu e-mail" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <label>Senha</label>
                    <input asp-for="Senha" type="password" class="form-control" placeholder="Digite sua senha" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-twitter full-width">Entrar</button>
            </form>

            <div class="center-link">
                <a asp-controller="Login" asp-action="Cadastro">Criar conta</a>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>